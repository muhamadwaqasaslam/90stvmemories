# Admin login (required in production)
ADMIN_PASSWORD=change-me
SESSION_SECRET=long-random-string

# Storage on Vercel: add the Upstash Redis integration (Marketplace) and these are set automatically.
# Without them the app falls back to a local JSON file in .data/ (local dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public site URL (for SEO / share cards)
NEXT_PUBLIC_SITE_URL=https://90stvmemories.vercel.app

# Media uploads (images & video). Vercel: Storage -> Blob -> create a PUBLIC store and connect it; this is added automatically.
# Local dev without it saves files to public/uploads (not for production).
BLOB_READ_WRITE_TOKEN=

# Optional: shown on the About page
NEXT_PUBLIC_CONTACT_EMAIL=
